{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feishu2agents",
  "main": "cloudflare_worker/src/entry.py",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feishu2agents-state",
      "database_id": "45b634df-226e-42cb-9c1e-cc5311329ade",
      "migrations_dir": "cloudflare_worker/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AGENT_QUEUE",
        "queue": "feishu2agents-agent-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "feishu2agents-agent-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
