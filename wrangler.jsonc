{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feishu2agents",
  "account_id": "3babaa7cfa54ae9ac91af0b0dfd8e80b",
  "main": "cloudflare_worker/src/entry.py",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "bot.boooe.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "XIAOT_PUBLIC_BASE_URL": "https://bot.boooe.com",
    "XIAOT_FEISHU_OAUTH_REDIRECT_URI": "https://bot.boooe.com/feishu/oauth/callback",
    "XIAOT_LARK_OAUTH_REDIRECT_URI": "https://bot.boooe.com/lark/oauth/callback",
    "XIAOT_AGENT_QUEUE_NAME": "feishu2agents-dev-agent-jobs"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feishu2agents-prd-state",
      "database_id": "de158ca8-3236-4cc8-be02-29974a951a48",
      "migrations_dir": "cloudflare_worker/migrations"
    },
    {
      "binding": "XIAOT_DB",
      "database_name": "feishu2agents-dev-state",
      "database_id": "f56585bf-45cc-42fb-917e-3b537a33f353",
      "migrations_dir": "cloudflare_worker/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AGENT_QUEUE",
        "queue": "feishu2agents-prd-agent-jobs"
      },
      {
        "binding": "XIAOT_AGENT_QUEUE",
        "queue": "feishu2agents-dev-agent-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "feishu2agents-dev-agent-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "feishu2agents-agent-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
