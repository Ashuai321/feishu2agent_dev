{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feishu2agents_dev",
  "main": "cloudflare_worker/src/entry.py",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "vars": {
    "FEISHU_OAUTH_REDIRECT_URI": "https://feishu2agents_dev.bo-3ba.workers.dev/feishu/oauth/callback",
    "FEISHU_OAUTH_SCOPE": "bitable:app wiki:wiki:readonly offline_access",
    "LARK_OAUTH_REDIRECT_URI": "https://feishu2agents_dev.bo-3ba.workers.dev/lark/oauth/callback",
    "LARK_OAUTH_SCOPE": "bitable:app wiki:wiki:readonly offline_access",
    "WORKSPACE_AGENT_RELAY_OAUTH_TOKEN_TTL_SECONDS": "315360000",
    "BITABLE_WORKFLOW_GROUP_CHAT_ID": "oc_5e9132f3638772d53d92d6fc5e953abc",
    "LARK_DOCUMENT_WIKI_TOKEN": "UmGRwFFDQiegHckOVh0j0DIrpRc",
    "LARK_DOCUMENT_TABLE_ID": "tblmd8DAQwM00t7B",
    "WORKSPACE_AGENT_RELAY_PUBLIC_BASE_URL": "https://feishu2agents_dev.bo-3ba.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feishu2agents-dev-state",
      "database_id": "f56585bf-45cc-42fb-917e-3b537a33f353",
      "migrations_dir": "cloudflare_worker/migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AGENT_QUEUE",
        "queue": "feishu2agents-dev-agent-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "feishu2agents-dev-agent-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
