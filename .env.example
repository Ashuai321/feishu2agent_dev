# Cloudflare Python Worker / Feishu Webhook
# These values are Worker Secrets in production (`npx wrangler secret put ...`).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFY_TOKEN=
# Required for fast webhook acknowledgement. Get it from Feishu bot/v3/info once.
FEISHU_BOT_OPEN_ID=
# Optional Feishu user OAuth. The default callback is the Cloudflare Worker
# endpoint below; register it in the Feishu app's redirect URL allowlist.
FEISHU_OAUTH_REDIRECT_URI=https://bot.boooe.com/feishu/oauth/callback
FEISHU_OAUTH_SCOPE=bitable:app wiki:wiki:readonly offline_access
FEISHU_OAUTH_STATE_TTL_SECONDS=600
# Optional local user token override; normally use .feishu-user-token.json.
FEISHU_USER_ACCESS_TOKEN=

# ==== Lark 机器人（可选；填写后本地进程会同时监听 Lark） ====
# Lark uses the same event/API shapes but has separate credentials and domains.
LARK_APP_ID=
LARK_APP_SECRET=
# Required for the Cloudflare webhook fast path; get it from Lark bot/v3/info.
LARK_BOT_OPEN_ID=
LARK_VERIFY_TOKEN=
LARK_OAUTH_REDIRECT_URI=https://bot.boooe.com/lark/oauth/callback
LARK_OAUTH_SCOPE=bitable:app wiki:wiki:readonly offline_access
LARK_OAUTH_STATE_TTL_SECONDS=600
LARK_EVENT_MODE=long_connection
# Optional comma-separated sender tenant keys that should always use Lark OAuth.
LARK_EXTERNAL_TENANT_KEYS=
# Optional local user token override; normally use .lark-user-token.json.
LARK_USER_ACCESS_TOKEN=

# Only this group uses the direct "authorize -> write Bitable" test workflow.
# Other groups continue to use the existing Workspace Agent relay.
BITABLE_WORKFLOW_GROUP_CHAT_ID=oc_5e9132f3638772d53d92d6fc5e953abc
# The [lark文档] command uses this Lark wiki/table target.
LARK_DOCUMENT_WIKI_TOKEN=UmGRwFFDQiegHckOVh0j0DIrpRc
LARK_DOCUMENT_TABLE_ID=tblmd8DAQwM00t7B

# Bitable automation HTTP action -> 小 C group notification.
# Leave empty for an unauthenticated Feishu workflow callback during testing;
# when set, add the same value as X-Bitable-Webhook-Token in the HTTP action.
BITABLE_AUTOMATION_WEBHOOK_TOKEN=

# Stable public URL. The Worker defaults to this exact permanent domain.
WORKSPACE_AGENT_RELAY_PUBLIC_BASE_URL=https://bot.boooe.com
WORKSPACE_AGENT_RELAY_OAUTH_SCOPES=workspace-agent-relay
WORKSPACE_AGENT_RELAY_OAUTH_TOKEN_TTL_SECONDS=315360000
WORKSPACE_AGENT_RELAY_OAUTH_REFRESH_TOKEN_TTL_SECONDS=0
# Set to oauth (recommended), shared_token, or none for local development.
WORKSPACE_AGENT_RELAY_AUTH_MODE=oauth
WORKSPACE_AGENT_RELAY_OAUTH_LOGIN_TOKEN=
WORKSPACE_AGENT_RELAY_AUTH_TOKEN=

# Published Workspace Agent trigger endpoint and its bearer token.
# This is the Agent API endpoint, not PYTHON_ORIGIN and not a tunnel URL.
WORKSPACE_AGENT_RELAY_TRIGGER_URL=
WORKSPACE_AGENT_RELAY_AGENT_TOKEN=
# Optional Agent definitions for Feishu tests. Existing settings above remain
# unchanged; add one trigger URL or comma-separated URLs to select targets.
# Use `all` to activate every Agent already registered in the relay database.
activated_agents=
# For a new URL, pair it with a token under the supported token namespace:
# WORKSPACE_AGENT_RELAY_AGENT_TOKEN_<NAME>=
# WORKSPACE_AGENT_RELAY_AGENT_<NAME>_TRIGGER_URL=
# WORKSPACE_AGENT_RELAY_AGENT_NAME_<NAME>=

# Optional only for local legacy ASGI development. It is not used by the
# Cloudflare Python Worker and must not be set to a Worker URL.
FEISHU_EVENT_MODE=webhook

# ==== 可复用工具（非分支逻辑，按需使用） ====
# stepone（DeepSeek 意图分类）与 steptwo（OpenAI 直接回答）已抽为 feishu2agents.utils，
# 默认不使用，仅在需要时配以下密钥。
DEEPSEEK_API_KEY=
STEP_TWO_KEY=
