# ==== Feishu 机器人 ====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 事件接入方式：long_connection（长连接）| webhook（开发者服务器模式/HTTP 推送）
FEISHU_EVENT_MODE=webhook
# webhook 模式下的请求校验 token（与飞书事件订阅的 Verify Token 一致，可选）
FEISHU_VERIFY_TOKEN=

# 工作目录与结果轮询间隔
AGENT_WORKER_INTERVAL=2.0
STATEFILE=data/agent-results.sqlite3

# ==== 复用 workspace-agent-relay-mcp（目标项目）配置 ====
# 这些变量由目标项目 workspace-agent-relay-mcp 的 config.load_config() 读取，
# 保持与目标项目一致，以便直接复用现有云端隧道端口与 /mcp 接口，无需改动。
WORKSPACE_AGENT_RELAY_HOST=127.0.0.1
WORKSPACE_AGENT_RELAY_PORT=8799
WORKSPACE_AGENT_RELAY_STATE_DIR=/Users/shuai/.workspace-agent-relay-mcp
WORKSPACE_AGENT_RELAY_AUTH_MODE=oauth
WORKSPACE_AGENT_RELAY_PUBLIC_BASE_URL=https://east-setup-advert-bedding.trycloudflare.com
WORKSPACE_AGENT_RELAY_OAUTH_LOGIN_TOKEN=1c4df7cb4d25e9217369acbd99026d4b
WORKSPACE_AGENT_RELAY_OAUTH_SCOPES=workspace-agent-relay
WORKSPACE_AGENT_RELAY_OAUTH_TOKEN_TTL_SECONDS=86400
# Agent 访问令牌（对应 ChatGPT Workspace Agent trigger 的 bearer token）
WORKSPACE_AGENT_RELAY_AGENT_TOKEN=

# ==== 可复用工具（非分支逻辑，按需使用） ====
# stepone（DeepSeek 意图分类）与 steptwo（OpenAI 直接回答）已抽为 feishu2agents.utils，
# 默认不使用，仅在需要时配以下密钥。
DEEPSEEK_API_KEY=
STEP_TWO_KEY=
